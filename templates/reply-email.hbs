<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="{{faviconCid}}" />
  <title>Reply Email Template</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6fb;">
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#f4f6fb;">
    <tr>
      <td align="center" style="padding:40px 15px;">
        <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
               style="max-width:600px; background-color:#ffffff; border-radius:16px; overflow:hidden;">
          <tr>
            <td align="center" style="padding:30px 20px 10px;">
              <a href="index.html">
                <img style="width:200px; height:auto;" src="{{logoCid}}" alt="logo">
              </a>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px;">
              <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
                     style="background-image:url('{{emailBgCid}}'); background-repeat:no-repeat; background-size:cover; background-position:center; border-radius:10px;">
                <tr>
                  <td align="center" style="padding:50px 20px;">
                    <h2 style="margin:0; font-family:Arial, Helvetica, sans-serif; font-size:28px; font-weight:bold; color:#ffffff;">
                      Welcom To <br> Techzaar Innovation
                    </h2>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px 30px;">
              <p style="margin:0 0 16px; font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; color:#555555;">
                Thank you for reaching out to Techzaar Innovation. We appreciate you getting in touch with us. Your information has been received and our team is currently reviewing your details. One of our specialists will get back to you shortly, typically within a few hours.
              </p>
              <p style="margin:0; font-family:Arial, Helvetica, sans-serif; font-size:14px; line-height:22px; color:#888888;">
                We respect your privacy and will never share your information.
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px 30px 30px;">
              <p style="margin:0; font-family:Arial, Helvetica, sans-serif; font-size:12px; color:#aaaaaa;">
                © 2025 Techzaar. All rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
